# Run this service only on a secured Windows VPS with MetaTrader 5 installed.
# Never commit real values to GitHub.
BRIDGE_API_KEY=replace-with-a-random-secret-at-least-32-characters
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# Safe defaults: real-account order execution is disabled.
ALLOW_LIVE_TRADING=false
LIVE_TRADING_ACK=
ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY
MAX_ORDER_VOLUME=0.01
MAX_OPEN_POSITIONS=3
LOG_LEVEL=INFO
